{
  "family": "uruuru",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::639261426101:role/uruuru-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::639261426101:role/uruuru-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "639261426101.dkr.ecr.ap-northeast-1.amazonaws.com/uruuru:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "RAILS_ENV", "value": "production" },
        { "name": "RAILS_LOG_TO_STDOUT", "value": "true" },
        { "name": "FORCE_SSL", "value": "true" },
        { "name": "AWS_EC2_METADATA_DISABLED", "value": "true" }
      ],
      "secrets": [
        { "name": "RAILS_MASTER_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/RAILS_MASTER_KEY" },
        { "name": "SECRET_KEY_BASE", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/SECRET_KEY_BASE" },
        { "name": "AWS_REGION", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/AWS_REGION" },
        { "name": "AWS_S3_BUCKET", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/AWS_S3_BUCKET" },
        { "name": "ACTIVE_STORAGE_SERVICE", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/ACTIVE_STORAGE_SERVICE" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:ap-northeast-1:639261426101:parameter/uruuru/DATABASE_URL" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "ap-northeast-1",
          "awslogs-group": "/ecs/uruuru",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
